# ==============================================================================
# HANZALA CAR WASH - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for local development or staging
# ==============================================================================

# Application Meta
VITE_APP_NAME="Hanzala Car Wash"
VITE_APP_TAGLINE="Premium Car Wash & Detailing Services"
VITE_DEFAULT_LOCALE="en"
VITE_DEFAULT_CURRENCY="PKR"
VITE_DEFAULT_CURRENCY_SYMBOL="Rs."

# API Endpoints (When connecting to external backend)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_STORAGE_URL="http://localhost:8000/storage"

# Payment Gateways (Sandbox Mode for local QA - SRS Section 9)
VITE_PAYMENT_MODE="sandbox" # 'sandbox' | 'production'
VITE_STRIPE_PUBLIC_KEY="pk_test_sample_hanzala_stripe"
VITE_JAZZCASH_MERCHANT_ID="MC_TEST_12345"
VITE_EASYPAISA_STORE_ID="ES_TEST_67890"

# Messaging & Notification Webhooks (SRS Section 13)
VITE_WHATSAPP_BUSINESS_PHONE="+923008492000"
VITE_SMS_PROVIDER_ENDPOINT=""

# Booking Policy Defaults (SRS Section 10)
VITE_POLICY_CANCELLATION_CUTOFF_HOURS=2
VITE_POLICY_DEDUCTION_PERCENT=5
VITE_POLICY_NO_SHOW_GRACE_MINS=20
